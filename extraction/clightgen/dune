; Copy architecture-specific dependencies of the extraction module.
(copy_files %{project_root}/%{env:TARGET_ARCH=undefined}/{extractionMachdepClight.v})

; Generate "new" extractionClight.v to create an explicit dependency on extractionMachdepClight.v.
; If we use extractionClight.v directly, coqdep fails to find the machdep files as dependencies
;  so they are not copied here and consequently not found on the loadpath.
; Manually adding them to the loadpath in the coq.extraction stanza's flags field works for running the extraction,
;  but since there is no dependency the extraction is not rerun if the files change.
(rule
 (deps ../extractionClight.v extractionMachdepClight.v)
 (targets extractionClight.v)
 (action (copy ../extractionClight.v extractionClight.v)))

; Extraction for Clight: Independent of architecture & backend
; use all the relevant .v files and extract them to OCaml files.
(coq.extraction 
 (prelude extractionClight)
 (extracted_modules 
